{
  "name": "lti-mock-environment",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run lms\" \"npm run tool\" \"npm run tool-client\" \"npm run dev-portal\"",
    "lms": "node lms-platform.js",
    "tool": "node tool-provider/server.js",
    "tool-client": "cd tool-provider/client && npm run dev",
    "dev-portal": "node dev-portal.js"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "jose": "^5.1.3",
    "uuid": "^9.0.1"
  }
}
